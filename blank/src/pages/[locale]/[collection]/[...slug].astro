---
import { render } from "astro:content";
import ContentEntry from "../../../layouts/ContentEntry.astro";
import { getLocalizedContentPaths } from "../../../lib/content-routes";

export async function getStaticPaths() {
  return getLocalizedContentPaths();
}

const { entry, collection } = Astro.props;
const { Content } = await render(entry);
---

<ContentEntry collection={collection} {...entry.data}>
  <Content />
</ContentEntry>
