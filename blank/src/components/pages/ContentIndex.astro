---
import site from "../../config/site.json";
import Layout from "../../layouts/Layout.astro";
import SiteHeader from "../SiteHeader.astro";
import SiteFooter from "../SiteFooter.astro";
import { defaultLocale, getMessages, localePath } from "../../lib/i18n";

interface Props {
  collection: string;
  entries: Array<{ id: string; data: Record<string, unknown> }>;
}

const { collection, entries } = Astro.props;
const locale = Astro.currentLocale ?? defaultLocale;
const messages = getMessages(locale);
const title = collection.replace(/[-_]+/g, " ");
const items = entries
  .map((entry) => {
    const prefix = `${collection}/`;
    const slug = entry.id.startsWith(prefix) ? entry.id.slice(prefix.length) : entry.id;
    return {
      slug,
      title: typeof entry.data.title === "string" && entry.data.title.trim() ? entry.data.title : slug.split("/").pop() ?? "Content",
      description: typeof entry.data.description === "string" ? entry.data.description : undefined,
    };
  })
  .sort((a, b) => a.title.localeCompare(b.title, locale));
---
<Layout title={`${title} | ${site.title}`} description={site.description}>
  <SiteHeader />
  <main class="site-container py-16 sm:py-24">
    <p class="text-sm font-semibold uppercase tracking-[0.2em] text-primary">{collection}</p>
    <h1 class="mt-4 text-5xl font-bold capitalize tracking-[-0.05em] sm:text-7xl">{title}</h1>
    <p class="mt-6 max-w-2xl text-lg text-muted-foreground">{messages.content?.collectionDescription ?? "Content from this collection is published from the Git repository."}</p>
    {items.length > 0 ? <div class="mt-12 divide-y divide-border border-y border-border">
      {items.map((item) => <a class="group flex items-center justify-between gap-6 py-7" href={localePath(locale, `/${collection}/${item.slug}/`)}>
        <div><h2 class="text-2xl font-semibold tracking-tight group-hover:text-primary">{item.title}</h2>{item.description && <p class="mt-2 text-muted-foreground">{item.description}</p>}</div>
        <span class="text-2xl text-primary" aria-hidden="true">↗</span>
      </a>)}
    </div> : <div class="mt-12 rounded-xl border border-dashed border-border p-10 text-muted-foreground">{messages.content?.empty ?? "No content published yet."}</div>}
  </main>
  <SiteFooter />
</Layout>
