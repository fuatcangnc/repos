---
import { ArrowUpRightIcon } from "@lucide/astro";
import {
  NavigationMenu,
  NavigationMenuItem,
  NavigationMenuLink,
  NavigationMenuList,
} from "@/components/ui/navigation-menu";
import { Button } from "@/components/ui/button";
import site from "../config/site.json";
import { defaultLocale, localePath, getMessages } from "../lib/i18n";

const locale = Astro.currentLocale ?? defaultLocale;
const messages = getMessages(locale);
const navigation = Array.isArray(site.navigation) ? site.navigation : [];
---
<header class="site-container flex min-h-20 items-center justify-between gap-6 border-b border-border">
  <a class="inline-flex items-center gap-3 font-semibold tracking-tight" href={localePath(locale, "/")} aria-label={site.title}>
    <span class="grid size-9 place-items-center rounded-lg bg-primary text-sm font-bold text-primary-foreground">{site.title.slice(0, 1)}</span>
    <span>{site.title}</span>
  </a>
  <NavigationMenu class="hidden md:flex" aria-label={messages.nav?.menu ?? "Main navigation"}>
    <NavigationMenuList class="gap-1">
      {navigation.map((item) => (
        <NavigationMenuItem value={item.href}>
          <NavigationMenuLink href={localePath(locale, item.href)}>{item.label}</NavigationMenuLink>
        </NavigationMenuItem>
      ))}
    </NavigationMenuList>
  </NavigationMenu>
  <Button as="a" href={localePath(locale, "/blog/")} variant="outline" class="hidden sm:inline-flex">
    {messages.nav?.blog ?? "Blog"}
    <ArrowUpRightIcon aria-hidden="true" />
  </Button>
</header>
