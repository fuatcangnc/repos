---
import site from "../config/site.json";
import { defaultLocale, localePath } from "../lib/i18n";

const locale = Astro.currentLocale ?? defaultLocale;
---
<footer class="site-container flex flex-col gap-3 border-t border-border py-8 text-sm text-muted-foreground sm:flex-row sm:items-center sm:justify-between">
  <a class="font-medium text-foreground" href={localePath(locale, "/")}>{site.title}</a>
  <span>{site.footer || `© ${new Date().getFullYear()} ${site.title}`}</span>
  {site.email && <a href={`mailto:${site.email}`}>{site.email}</a>}
</footer>
