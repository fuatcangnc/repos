---
import site from "../config/site.json";
import Layout from "./Layout.astro";
import SiteHeader from "../components/SiteHeader.astro";
import SiteFooter from "../components/SiteFooter.astro";
import { defaultLocale, localePath } from "../lib/i18n";

interface Props {
  title?: string;
  description?: string;
  pubDate?: Date;
  publishedAt?: Date;
  updatedAt?: Date;
  author?: string;
  collection: string;
}

const { title, description, pubDate, publishedAt, updatedAt, author, collection } = Astro.props;
const locale = Astro.currentLocale ?? defaultLocale;
const heading = title || "Content";
const date = updatedAt ?? publishedAt ?? pubDate;
const dateLabel = date
  ? new Intl.DateTimeFormat(locale, { dateStyle: "long" }).format(new Date(date))
  : undefined;
---
<Layout title={heading} description={description ?? site.description}>
  <SiteHeader />
  <main class="site-container max-w-3xl py-16 sm:py-24">
    <a class="text-sm text-muted-foreground underline-offset-4 hover:underline" href={localePath(locale, `/${collection}/`)}>← Back to {collection}</a>
    <p class="mt-10 text-sm font-medium uppercase tracking-[0.2em] text-primary">{collection}</p>
    <h1 class="mt-4 text-4xl font-bold tracking-tight sm:text-6xl">{heading}</h1>
    {description && <p class="mt-6 text-lg text-muted-foreground">{description}</p>}
    <div class="mt-5 flex gap-4 text-sm text-muted-foreground">
      {dateLabel && <time datetime={new Date(date).toISOString()}>{dateLabel}</time>}
      {author && <span>{author}</span>}
    </div>
    <article class="prose prose-neutral mt-12 max-w-none border-t border-border pt-10 text-base leading-8 [&_a]:text-primary [&_a]:underline [&_h2]:mt-10 [&_h2]:text-3xl [&_h2]:font-bold [&_h3]:mt-8 [&_h3]:text-2xl [&_h3]:font-semibold [&_img]:h-auto [&_img]:max-w-full [&_li]:my-2 [&_p]:my-5 [&_pre]:overflow-x-auto [&_pre]:rounded-lg [&_pre]:bg-muted [&_pre]:p-4 [&_ul]:my-5">
      <slot />
    </article>
  </main>
  <SiteFooter />
</Layout>
