---
import { getCollection, render } from 'astro:content';
import ContentEntry from '../../../layouts/ContentEntry.astro';
import { prefixedLocales } from '../../../lib/i18n';

export async function getStaticPaths() {
	const posts = await getCollection('blog');
	return prefixedLocales().flatMap((locale) => posts.map((post) => ({
		params: { locale, slug: post.id },
		props: { post },
	})));
}

const { post } = Astro.props;
const { Content } = await render(post);
---

<ContentEntry {...post.data} collection="blog">
	<Content />
</ContentEntry>
