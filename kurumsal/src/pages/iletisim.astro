---
import Layout from '../layouts/Layout.astro';
import site from '../config/site.json';
---
<Layout title={`İletişim — ${site.title}`} description="Projenizi konuşalım."><main class="page"><a class="back" href="/">← Ana sayfa</a><div class="eyebrow">İletişim</div><h1>Bir fikriniz varsa<br /><em>dinliyoruz.</em></h1><p>Projenizi, hedeflerinizi veya sadece aklınızdaki soruyu anlatın.</p><a class="contact" href={`mailto:${site.email}`}>{site.email} ↗</a></main></Layout>
<style>:global(body){margin:0;background:#f4f2ed;color:#18201b;font-family:Arial,sans-serif}.page{width:min(56rem,calc(100% - 2.5rem));margin:0 auto;padding:5rem 0 8rem}.back{display:inline-block;margin-bottom:8rem;color:#656b65;font-size:.85rem}.eyebrow{color:#e35d3e;font-size:.7rem;font-weight:700;letter-spacing:.16em;text-transform:uppercase}h1{margin:1.5rem 0 2rem;font-size:clamp(3.4rem,8vw,7rem);line-height:.9;letter-spacing:-.08em}h1 em{font-family:Georgia,serif;font-weight:400}p{color:#656b65;font-size:1.1rem;line-height:1.7}.contact{display:inline-block;margin-top:3rem;border-bottom:2px solid #b8ed4f;padding-bottom:.5rem;font-size:1.2rem;font-weight:700}</style>
