---
import Layout from '../../layouts/Layout.astro';
import site from '../../config/site.json';
import { defaultLocale, getMessages, localePath } from '../../lib/i18n';

const locale = Astro.currentLocale ?? defaultLocale;
const t = getMessages(locale);
---

<Layout title={`${t.services.eyebrow} — ${site.title}`} description={t.services.description}>
	<main class="page"><a class="back" href={localePath(locale, '/')}>{t.common.back}</a><div class="eyebrow">{t.services.eyebrow}</div><h1 set:html={t.services.title} /><div class="list">{t.services.items.map((item, index) => <article id={item.id}><b>{String(index + 1).padStart(2, '0')}</b><div><h2>{item.title}</h2><p>{item.copy}</p></div></article>)}</div></main>
</Layout>

<style>
	:global(body) { margin: 0; background: #f4f2ed; color: #18201b; font-family: Arial, sans-serif; }
	:global(a) { color: inherit; text-decoration: none; }
	.page { width: min(64rem, calc(100% - 2.5rem)); margin: 0 auto; padding: 5rem 0 8rem; }
	.back { display: inline-block; margin-bottom: 8rem; color: #656b65; font-size: .85rem; }
	.eyebrow { color: #e35d3e; font-size: .7rem; font-weight: 700; letter-spacing: .16em; text-transform: uppercase; }
	h1 { margin: 1.5rem 0 5rem; font-size: clamp(3.4rem, 8vw, 7rem); line-height: .9; letter-spacing: -.08em; }
	h1 :global(em) { font-family: Georgia, serif; font-weight: 400; }
	.list { border-top: 1px solid #18201b; }
	.list article { display: grid; grid-template-columns: 5rem 1fr; gap: 2rem; padding: 2rem 0; border-bottom: 1px solid #d8d8d0; }
	.list b { color: #e35d3e; font-size: .75rem; }
	.list h2 { margin: 0; font-size: 1.6rem; letter-spacing: -.04em; }
	.list p { max-width: 34rem; color: #656b65; line-height: 1.65; }
</style>
