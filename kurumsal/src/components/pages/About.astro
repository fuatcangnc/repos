---
import Layout from '../../layouts/Layout.astro';
import site from '../../config/site.json';
import { defaultLocale, getMessages, localePath } from '../../lib/i18n';

const locale = Astro.currentLocale ?? defaultLocale;
const t = getMessages(locale);
---

<Layout title={`${t.about.eyebrow} — ${site.title}`} description={t.about.description}>
	<main class="page"><a class="back" href={localePath(locale, '/')}>{t.common.back}</a><div class="eyebrow">{t.about.eyebrow}</div><h1 set:html={t.about.title} /><p>{t.about.copy}</p><a class="button" href={localePath(locale, '/iletisim/')}>{t.about.cta} ↗</a></main>
</Layout>

<style>
	:global(body) { margin: 0; background: #f4f2ed; color: #18201b; font-family: Arial, sans-serif; }
	:global(a) { color: inherit; text-decoration: none; }
	.page { width: min(56rem, calc(100% - 2.5rem)); margin: 0 auto; padding: 5rem 0 8rem; }
	.back { display: inline-block; margin-bottom: 8rem; color: #656b65; font-size: .85rem; }
	.eyebrow { color: #e35d3e; font-size: .7rem; font-weight: 700; letter-spacing: .16em; text-transform: uppercase; }
	h1 { margin: 1.5rem 0 2rem; font-size: clamp(3.4rem, 8vw, 7rem); line-height: .9; letter-spacing: -.08em; }
	h1 :global(em) { font-family: Georgia, serif; font-weight: 400; }
	p { max-width: 35rem; color: #656b65; font-size: 1.1rem; line-height: 1.7; }
	.button { display: inline-block; margin-top: 2.5rem; padding: 1rem 1.25rem; background: #18201b; color: #fff; font-weight: 700; text-decoration: none; }
</style>
