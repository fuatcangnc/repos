---
import Layout from '../../layouts/Layout.astro';
import site from '../../config/site.json';
import { defaultLocale, getMessages, localePath } from '../../lib/i18n';

const locale = Astro.currentLocale ?? defaultLocale;
const t = getMessages(locale);
---

<Layout title={site.title} description={site.description}>
	<header class="site-header">
		<a class="brand" href={localePath(locale, '/')} aria-label={site.title}><span class="brand-mark">K</span><span>{site.title}</span></a>
		<nav aria-label={t.common.menu}><a href={localePath(locale, '/hakkimizda/')}>{t.nav.about}</a><a href={localePath(locale, '/hizmetler/')}>{t.nav.services}</a><a href={localePath(locale, '/iletisim/')}>{t.nav.contact}</a></nav>
		<a class="header-cta" href={localePath(locale, '/iletisim/')}>{t.nav.cta} <span>↗</span></a>
	</header>
	<main>
		<section class="hero wrapper"><div class="eyebrow">{t.home.heroEyebrow}</div><h1 set:html={t.home.heroTitle} /><p class="hero-copy">{t.home.heroCopy}</p><div class="hero-actions"><a class="button button-dark" href={localePath(locale, '/iletisim/')}>{t.home.heroPrimaryCta} <span>↗</span></a><a class="text-link" href={localePath(locale, '/hizmetler/')}>{t.home.heroSecondaryCta} <span>→</span></a></div><div class="hero-note"><span class="status-dot"></span> {t.home.heroNote}</div></section>
		<section class="statement band"><div class="wrapper split"><div class="eyebrow">{t.home.statementEyebrow}</div><div><h2 set:html={t.home.statementTitle} /><p>{t.home.statementCopy}</p></div></div></section>
		<section class="services wrapper"><div class="section-heading"><div><div class="eyebrow">{t.home.servicesEyebrow}</div><h2 set:html={t.home.servicesTitle} /></div></div><div class="service-grid">{t.home.serviceCards.map((card, index) => <a class="service-card" href={localePath(locale, card.href)}><span class="service-number">{String(index + 1).padStart(2, '0')}</span><h3>{card.title}</h3><p>{card.copy}</p><span class="arrow">↗</span></a>)}</div></section>
		<section class="callout wrapper"><div><div class="eyebrow">{t.home.calloutEyebrow}</div><h2 set:html={t.home.calloutTitle} /></div><a class="button button-light" href={localePath(locale, '/iletisim/')}>{t.home.calloutCta} <span>↗</span></a></section>
	</main>
	<footer class="site-footer wrapper"><a class="brand" href={localePath(locale, '/')}><span class="brand-mark">K</span><span>{site.title}</span></a><span>{site.footer}</span><a href={`mailto:${site.email}`}>{site.email}</a></footer>
</Layout>

<style>
	:global(*) { box-sizing: border-box; }
	:global(body) { margin: 0; background: #f4f2ed; color: #18201b; font-family: Arial, sans-serif; }
	:global(a) { color: inherit; text-decoration: none; }
	.site-header, .site-footer { display: flex; align-items: center; gap: 2rem; min-height: 5rem; }
	.site-header { border-bottom: 1px solid #d8d8d0; padding: 0 max(1.25rem, calc((100% - 72rem) / 2)); }
	.site-header nav { display: flex; gap: 1.5rem; margin-left: auto; font-size: .85rem; color: #656b65; }
	.brand { display: inline-flex; align-items: center; gap: .6rem; font-weight: 700; letter-spacing: -.03em; }
	.brand-mark { display: grid; place-items: center; width: 1.7rem; height: 1.7rem; background: #b8ed4f; color: #14210d; font-size: .85rem; }
	.header-cta, .button { display: inline-flex; align-items: center; justify-content: center; gap: 1.25rem; padding: .9rem 1.25rem; font-weight: 700; font-size: .85rem; }
	.header-cta { background: #18201b; color: #fff; min-width: 8.5rem; }
	.wrapper { width: min(72rem, calc(100% - 2.5rem)); margin-inline: auto; }
	.hero { padding: 9rem 0 8rem; }
	.eyebrow { color: #e35d3e; font-size: .7rem; font-weight: 700; letter-spacing: .16em; text-transform: uppercase; }
	h1, h2, h3, p { margin: 0; }
	h1 { max-width: 52rem; margin-top: 1.5rem; font-size: clamp(3.6rem, 8vw, 7rem); line-height: .92; letter-spacing: -.08em; }
	h1 :global(em), h2 :global(em) { font-family: Georgia, serif; font-weight: 400; letter-spacing: -.06em; }
	.hero-copy { max-width: 30rem; margin-top: 2.25rem; color: #656b65; font-size: 1.05rem; line-height: 1.7; }
	.hero-actions { display: flex; align-items: center; gap: 1.5rem; margin-top: 2.5rem; }
	.button-dark { background: #18201b; color: #fff; }
	.button-light { background: #b8ed4f; color: #14210d; }
	.text-link { border-bottom: 1px solid #18201b; padding-bottom: .25rem; font-size: .85rem; font-weight: 700; }
	.hero-note { display: flex; align-items: center; gap: .5rem; margin-top: 4.5rem; color: #777c77; font-size: .8rem; }
	.status-dot { width: .45rem; height: .45rem; border-radius: 999px; background: #55a536; }
	.band { border-block: 1px solid #d8d8d0; }
	.split { display: grid; grid-template-columns: 1fr 2fr; gap: 3rem; padding: 7rem 0; }
	h2 { font-size: clamp(2.5rem, 5vw, 4.75rem); line-height: .98; letter-spacing: -.07em; }
	.split p { max-width: 31rem; margin-top: 2rem; color: #656b65; line-height: 1.7; }
	.services { padding: 7rem 0; }
	.section-heading h2 { margin-top: 1rem; }
	.service-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1rem; margin-top: 4rem; }
	.service-card { position: relative; min-height: 17rem; padding: 1.5rem; border-top: 1px solid #18201b; background: #ebe9e2; transition: transform .2s, background .2s; }
	.service-card:hover { transform: translateY(-.35rem); background: #b8ed4f; }
	.service-number { color: #e35d3e; font-size: .75rem; font-weight: 700; }
	.service-card h3 { margin-top: 4rem; font-size: 1.35rem; letter-spacing: -.04em; }
	.service-card p { margin-top: .75rem; color: #656b65; font-size: .9rem; line-height: 1.5; }
	.arrow { position: absolute; top: 1.5rem; right: 1.5rem; font-size: 1.5rem; }
	.callout { display: flex; align-items: end; justify-content: space-between; padding: 4rem 0 7rem; border-top: 1px solid #18201b; }
	.callout h2 { margin-top: 1rem; }
	.site-footer { justify-content: space-between; border-top: 1px solid #d8d8d0; color: #777c77; font-size: .75rem; }
	@media (max-width: 700px) { .site-header nav, .header-cta { display: none; } .site-header { min-height: 4rem; } .hero { padding: 6rem 0; } .split, .service-grid { grid-template-columns: 1fr; } .split { padding: 5rem 0; } .callout, .site-footer { align-items: start; flex-direction: column; } .site-footer { gap: .75rem; padding: 2rem 0; } }
</style>
