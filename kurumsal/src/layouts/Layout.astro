---
import { Font } from "astro:assets";
import site from "../config/site.json";
import { defaultLocale } from "../lib/i18n";
import "../styles/global.css";

interface Props {
  title: string;
  description: string;
}

type UIConfig = {
  container?: unknown;
  gutter?: unknown;
  background?: unknown;
  surface?: unknown;
  primary?: unknown;
  foreground?: unknown;
  mutedForeground?: unknown;
  border?: unknown;
  baseSize?: unknown;
  lineHeight?: unknown;
  radius?: unknown;
  cardSpacing?: unknown;
  controlRadius?: unknown;
  buttonPadding?: unknown;
  buttonHeight?: unknown;
  buttonWeight?: unknown;
};

const { title, description } = Astro.props;
const locale = Astro.currentLocale ?? defaultLocale;
const ui = ((site as typeof site & { ui?: UIConfig }).ui ?? {}) as UIConfig;

const hexColor = (value: unknown, fallback: string) =>
  typeof value === "string" && /^#[0-9a-f]{6}$/i.test(value)
    ? value.toUpperCase()
    : fallback;
const selectValue = <T extends Record<string, string>>(
  value: unknown,
  values: T,
  fallback: T[keyof T],
) =>
  typeof value === "string" && value in values
    ? values[value as keyof T]
    : fallback;
const primary = hexColor(ui.primary, "#2563EB");
const red = Number.parseInt(primary.slice(1, 3), 16);
const green = Number.parseInt(primary.slice(3, 5), 16);
const blue = Number.parseInt(primary.slice(5, 7), 16);
const luminance = (red * 299 + green * 587 + blue * 114) / 1000;
const primaryForeground = luminance > 158 ? "#171717" : "#F8FAFC";
const containerWidth = selectValue(
  ui.container,
  { "5xl": "64rem", "6xl": "72rem", "7xl": "80rem" },
  "80rem",
);
const gutter = selectValue(
  ui.gutter,
  { compact: "1rem", standard: "1.5rem", spacious: "2rem" },
  "1.5rem",
);
const baseSize = selectValue(
  ui.baseSize,
  { "14": "14px", "16": "16px", "18": "18px" },
  "16px",
);
const lineHeight = selectValue(
  ui.lineHeight,
  { compact: "1.45", standard: "1.6", relaxed: "1.75" },
  "1.6",
);
const radius = selectValue(
  ui.radius,
  { sm: "0.375rem", md: "0.625rem", lg: "0.875rem" },
  "0.875rem",
);
const controlRadius = selectValue(
  ui.controlRadius,
  { sm: "0.375rem", md: "0.625rem", lg: "0.875rem" },
  "0.875rem",
);
const cardSpacing = selectValue(
  ui.cardSpacing,
  { compact: "1rem", standard: "1.5rem", generous: "2rem" },
  "1.5rem",
);
const buttonPadding = selectValue(
  ui.buttonPadding,
  {
    compact: "0.375rem 0.75rem",
    standard: "0.5rem 1rem",
    generous: "0.625rem 1.25rem",
  },
  "0.5rem 1rem",
);
const buttonHeight = selectValue(
  ui.buttonHeight,
  { compact: "2rem", standard: "2.5rem", generous: "3rem" },
  "2.5rem",
);
const buttonWeight = selectValue(
  ui.buttonWeight,
  { "500": "500", "600": "600", "700": "700" },
  "600",
);
const background = hexColor(ui.background, "#FFFFFF");
const surface = hexColor(ui.surface, "#FFFFFF");
const foreground = hexColor(ui.foreground, "#171717");
const border = hexColor(ui.border, "#E4E4E7");
const uiStyle = [
  `--site-container-width: ${containerWidth}`,
  `--site-container-gutter: ${gutter}`,
  `--site-base-size: ${baseSize}`,
  `--site-line-height: ${lineHeight}`,
  `--site-card-radius: ${radius}`,
  `--site-card-spacing: ${cardSpacing}`,
  `--site-control-radius: ${controlRadius}`,
  `--site-button-padding: ${buttonPadding}`,
  `--site-button-height: ${buttonHeight}`,
  `--site-button-font-weight: ${buttonWeight}`,
  `--background: ${background}`,
  `--card: ${surface}`,
  `--card-foreground: ${foreground}`,
  `--popover: ${surface}`,
  `--popover-foreground: ${foreground}`,
  `--primary: ${primary}`,
  `--primary-foreground: ${primaryForeground}`,
  `--foreground: ${foreground}`,
  `--muted-foreground: ${hexColor(ui.mutedForeground, "#71717A")}`,
  `--border: ${border}`,
  `--input: ${border}`,
  `--ring: ${primary}`,
  `--radius: ${radius}`,
].join(";");
---
<!doctype html>
<html lang={locale} style={uiStyle}>
	<head>
		<!-- bejamas:astro-fonts:start -->
		<Font cssVariable="--font-sans" />
		<!-- bejamas:astro-fonts:end -->
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<meta name="description" content={description} />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<title>{title}</title>
	</head>
	<body><slot /></body>
</html>
