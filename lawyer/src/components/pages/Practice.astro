---
import site from '../../config/site.json';
import Layout from '../../layouts/Layout.astro';
import SiteFooter from '../SiteFooter.astro';
import SiteHeader from '../SiteHeader.astro';
import { defaultLocale, getMessages, localePath } from '../../lib/i18n';

const locale = Astro.currentLocale ?? defaultLocale;
const t = getMessages(locale);
---

<Layout title={`${t.nav.practice} — ${site.title}`} description={t.practice.copy}>
  <SiteHeader />
  <main>
    <section class="mx-auto w-[min(var(--site-container-width),calc(100%-2*var(--site-container-gutter)))] py-20 sm:py-28"><p class="text-xs font-semibold uppercase tracking-[0.22em] text-primary">{t.practice.eyebrow}</p><h1 class="mt-7 max-w-4xl font-serif text-6xl leading-[0.88] tracking-[-0.065em] sm:text-8xl">{t.practice.title.split('\n').map((line) => <span class="block">{line}</span>)}</h1><p class="mt-9 max-w-xl text-lg leading-8 text-muted">{t.practice.copy}</p></section>
    <section class="border-line border-y"><div class="mx-auto w-[min(var(--site-container-width),calc(100%-2*var(--site-container-gutter)))]">{t.practice.items.map((item) => <article class="grid gap-7 border-line border-b py-10 last:border-b-0 sm:grid-cols-[5rem_0.8fr_1fr] sm:py-14"><span class="text-xs font-semibold text-primary">{item.number}</span><h2 class="font-serif text-4xl leading-none tracking-[-0.05em] sm:text-5xl">{item.title}</h2><div><p class="leading-7 text-muted">{item.copy}</p><ul class="mt-7 grid gap-2 text-sm">{item.details.map((detail) => <li class="flex items-center gap-3"><span class="size-1.5 rounded-full bg-primary"></span>{detail}</li>)}</ul></div></article>)}</div></section>
    <section class="mx-auto flex w-[min(var(--site-container-width),calc(100%-2*var(--site-container-gutter)))] flex-col gap-8 py-20 sm:py-28 md:flex-row md:items-end md:justify-between"><div><h2 class="font-serif text-4xl leading-none tracking-[-0.05em] sm:text-6xl">{t.practice.ctaTitle}</h2><p class="mt-5 max-w-lg leading-7 text-muted">{t.practice.ctaCopy}</p></div><a class="inline-flex h-[var(--site-button-height)] items-center rounded-[var(--site-control-radius)] bg-primary px-5 font-semibold text-primary-foreground" href={localePath(locale, '/contact/')}>{t.practice.cta}<span class="ms-6">↗</span></a></section>
  </main>
  <SiteFooter />
</Layout>
