---
import { getCollection } from 'astro:content';
import site from '../../config/site.json';
import Layout from '../../layouts/Layout.astro';
import SiteFooter from '../SiteFooter.astro';
import SiteHeader from '../SiteHeader.astro';
import { defaultLocale, getMessages, localePath } from '../../lib/i18n';

const locale = Astro.currentLocale ?? defaultLocale;
const t = getMessages(locale);
const posts = (await getCollection('blog', ({ data }) => data.draft !== true)).sort((a, b) => new Date(b.data.pubDate ?? 0).getTime() - new Date(a.data.pubDate ?? 0).getTime());
---

<Layout title={`${t.blog.title} — ${site.title}`} description={t.blog.copy}>
  <SiteHeader />
  <main>
    <section class="mx-auto grid w-[min(var(--site-container-width),calc(100%-2*var(--site-container-gutter)))] gap-10 py-20 sm:py-28 lg:grid-cols-[0.7fr_1.3fr]"><p class="text-xs font-semibold uppercase tracking-[0.22em] text-primary">{t.blog.eyebrow}</p><div><h1 class="font-serif text-6xl leading-[0.88] tracking-[-0.065em] sm:text-8xl">{t.blog.title}</h1><p class="mt-9 max-w-xl text-lg leading-8 text-muted">{t.blog.copy}</p></div></section>
    <section class="border-line border-y"><div class="mx-auto w-[min(var(--site-container-width),calc(100%-2*var(--site-container-gutter)))]">{posts.length > 0 ? posts.map((post, index) => <a class="border-line group grid gap-5 border-b py-8 last:border-b-0 sm:grid-cols-[5rem_1fr_auto] sm:items-center sm:py-10" href={localePath(locale, `/blog/${post.id}/`)}><span class="text-xs font-semibold text-primary">{String(index + 1).padStart(2, '0')}</span><div><p class="text-xs text-muted">{post.data.pubDate ? new Intl.DateTimeFormat(locale, { dateStyle: 'long' }).format(new Date(post.data.pubDate)) : '—'}</p><h2 class="mt-2 max-w-2xl text-2xl font-semibold tracking-[-0.04em] group-hover:text-primary sm:text-3xl">{post.data.title}</h2>{post.data.description && <p class="mt-3 max-w-xl text-sm leading-6 text-muted">{post.data.description}</p>}</div><span class="text-2xl transition-transform group-hover:translate-x-1">↗</span></a>) : <p class="py-16 text-muted">{t.insights.empty}</p>}</div></section>
  </main>
  <SiteFooter />
</Layout>
