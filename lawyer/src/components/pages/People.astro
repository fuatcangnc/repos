---
import site from '../../config/site.json';
import Layout from '../../layouts/Layout.astro';
import SiteFooter from '../SiteFooter.astro';
import SiteHeader from '../SiteHeader.astro';
import { defaultLocale, getMessages, localePath } from '../../lib/i18n';

const locale = Astro.currentLocale ?? defaultLocale;
const t = getMessages(locale);
---

<Layout title={`${t.nav.people} — ${site.title}`} description={t.people.copy}>
  <SiteHeader />
  <main>
    <section class="mx-auto grid w-[min(var(--site-container-width),calc(100%-2*var(--site-container-gutter)))] gap-10 py-20 sm:py-28 lg:grid-cols-[0.7fr_1.3fr]"><p class="text-xs font-semibold uppercase tracking-[0.22em] text-primary">{t.people.eyebrow}</p><div><h1 class="font-serif text-6xl leading-[0.88] tracking-[-0.065em] sm:text-8xl">{t.people.title.split('\n').map((line) => <span class="block">{line}</span>)}</h1><p class="mt-9 max-w-xl text-lg leading-8 text-muted">{t.people.copy}</p></div></section>
    <section class="border-line border-y"><div class="mx-auto grid w-[min(var(--site-container-width),calc(100%-2*var(--site-container-gutter)))] gap-px bg-line md:grid-cols-3">{t.people.members.map((member, index) => <article class="bg-background p-6 sm:p-8"><div class="grid aspect-square place-items-center bg-ink text-primary"><span class="font-serif text-8xl">{String(index + 1).padStart(2, '0')}</span></div><h2 class="mt-7 text-xl font-semibold tracking-[-0.04em]">{member.name}</h2><p class="mt-1 text-sm text-primary">{member.role}</p><p class="mt-5 text-sm leading-6 text-muted">{member.bio}</p></article>)}</div></section>
    <section class="mx-auto w-[min(var(--site-container-width),calc(100%-2*var(--site-container-gutter)))] py-20 sm:py-28"><h2 class="max-w-3xl font-serif text-5xl leading-[0.95] tracking-[-0.06em] sm:text-7xl">{t.people.ctaTitle}</h2><a class="mt-9 inline-flex border-b border-ink pb-1 text-sm font-semibold" href={localePath(locale, '/contact/')}>{t.people.cta}<span class="ms-4">↗</span></a></section>
  </main>
  <SiteFooter />
</Layout>
