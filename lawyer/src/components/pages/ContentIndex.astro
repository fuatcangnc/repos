---
import site from '../../config/site.json';
import Layout from '../../layouts/Layout.astro';
import SiteFooter from '../SiteFooter.astro';
import SiteHeader from '../SiteHeader.astro';
import { defaultLocale, getMessages, localePath } from '../../lib/i18n';

interface Props { collection: string; entries: Array<{ id: string; data: { title?: string; description?: string; pubDate?: Date } }> }
const { collection, entries } = Astro.props;
const locale = Astro.currentLocale ?? defaultLocale;
const t = getMessages(locale);
---

<Layout title={`${collection} — ${site.title}`} description={site.description}>
  <SiteHeader />
  <main class="mx-auto w-[min(var(--site-container-width),calc(100%-2*var(--site-container-gutter)))] py-20 sm:py-28">
    <p class="text-xs font-semibold uppercase tracking-[0.22em] text-primary">{collection}</p>
    <h1 class="mt-7 max-w-4xl font-serif text-6xl leading-[0.88] tracking-[-0.065em] sm:text-8xl">{collection}</h1>
    <p class="mt-8 max-w-xl text-lg leading-8 text-muted">{site.description}</p>
    <div class="mt-16 border-t border-ink">
      {entries.map((entry, index) => <a class="border-line group grid gap-4 border-b py-7 sm:grid-cols-[4rem_1fr_auto] sm:items-center" href={localePath(locale, `/${collection}/${entry.id.split('/').slice(1).join('/')}/`)}><span class="text-xs font-semibold text-primary">{String(index + 1).padStart(2, '0')}</span><div><h2 class="text-2xl font-semibold tracking-[-0.04em] group-hover:text-primary">{entry.data.title ?? entry.id}</h2>{entry.data.description && <p class="mt-2 max-w-xl text-sm leading-6 text-muted">{entry.data.description}</p>}</div><span class="text-xl">↗</span></a>)}
    </div>
    {entries.length === 0 && <p class="mt-10 text-muted">{t.insights.empty}</p>}
  </main>
  <SiteFooter />
</Layout>
