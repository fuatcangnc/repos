---
import { getCollection } from 'astro:content';
import site from '../../config/site.json';
import Layout from '../../layouts/Layout.astro';
import SiteFooter from '../SiteFooter.astro';
import SiteHeader from '../SiteHeader.astro';
import { defaultLocale, getMessages, localePath } from '../../lib/i18n';

const locale = Astro.currentLocale ?? defaultLocale;
const t = getMessages(locale);
const posts = (await getCollection('blog', ({ data }) => data.draft !== true))
  .sort((a, b) => new Date(b.data.pubDate ?? 0).getTime() - new Date(a.data.pubDate ?? 0).getTime())
  .slice(0, 2);
const lines = (value: string) => value.split('\n');
---

<Layout title={site.title} description={t.home.copy}>
  <SiteHeader />
  <main>
    <section class="mx-auto grid min-h-[calc(100svh-4.5rem)] w-[min(var(--site-container-width),calc(100%-2*var(--site-container-gutter)))] items-center gap-14 py-20 lg:grid-cols-[1.05fr_0.95fr] lg:py-28">
      <div>
        <p class="text-xs font-semibold uppercase tracking-[0.22em] text-primary">{t.home.eyebrow}</p>
        <h1 class="mt-7 max-w-4xl font-serif text-6xl leading-[0.88] tracking-[-0.065em] sm:text-8xl">
          {lines(t.home.title).map((line, index) => <span class={index === lines(t.home.title).length - 1 ? 'block text-primary' : 'block'}>{line}</span>)}
        </h1>
        <p class="mt-9 max-w-xl text-lg leading-8 text-muted">{t.home.copy}</p>
        <div class="mt-10 flex flex-wrap items-center gap-4">
          <a class="inline-flex h-[var(--site-button-height)] items-center justify-center rounded-[var(--site-control-radius)] bg-ink px-5 text-sm font-semibold text-primary-foreground transition-transform hover:-translate-y-0.5" href={localePath(locale, '/contact/')}>{t.home.primaryCta}<span class="ms-5 text-primary">↗</span></a>
          <a class="inline-flex items-center gap-2 border-b border-ink pb-1 text-sm font-semibold" href={localePath(locale, '/practice/')}>{t.home.secondaryCta}<span>→</span></a>
        </div>
        <p class="mt-12 flex items-center gap-2 text-xs text-muted"><span class="size-2 rounded-full bg-primary"></span>{t.home.note}</p>
      </div>
      <div class="relative min-h-96 overflow-hidden rounded-[calc(var(--site-card-radius)*2)] bg-ink p-5 text-primary-foreground shadow-2xl shadow-ink/10 sm:min-h-[34rem] sm:p-8">
        <div class="absolute -end-16 -top-16 size-56 rounded-full border border-primary/50"></div>
        <div class="absolute -end-4 top-8 size-40 rounded-full border border-primary/30"></div>
        <div class="relative flex h-full flex-col justify-between">
          <div class="flex items-center justify-between text-xs uppercase tracking-[0.18em] text-primary-foreground/60"><span>A&V / 01</span><span>Est. 2011</span></div>
          <div class="self-end text-right sm:me-8"><p class="font-serif text-6xl leading-none text-primary sm:text-8xl">A</p><p class="mt-3 max-w-44 text-sm leading-6 text-primary-foreground/70">Measured advice for meaningful moments.</p></div>
          <div class="grid grid-cols-2 gap-4 border-t border-primary-foreground/20 pt-5 text-xs text-primary-foreground/60"><span>Strategy</span><span class="text-right">Judgment</span></div>
        </div>
      </div>
    </section>

    <section class="border-line border-y">
      <div class="mx-auto grid w-[min(var(--site-container-width),calc(100%-2*var(--site-container-gutter)))] gap-10 py-20 sm:py-28 lg:grid-cols-[0.7fr_1.3fr]">
        <p class="text-xs font-semibold uppercase tracking-[0.22em] text-primary">{t.home.manifestoLabel}</p>
        <div><h2 class="max-w-3xl font-serif text-5xl leading-[0.95] tracking-[-0.06em] sm:text-7xl">{t.home.manifestoTitle}</h2><p class="mt-8 max-w-2xl text-lg leading-8 text-muted">{t.home.manifestoCopy}</p></div>
      </div>
    </section>

    <section class="mx-auto w-[min(var(--site-container-width),calc(100%-2*var(--site-container-gutter)))] py-20 sm:py-28">
      <div class="grid gap-10 lg:grid-cols-[0.7fr_1.3fr]"><div><p class="text-xs font-semibold uppercase tracking-[0.22em] text-primary">{t.home.practiceLabel}</p><h2 class="mt-5 max-w-md font-serif text-5xl leading-[0.95] tracking-[-0.06em] sm:text-6xl">{lines(t.home.practiceTitle).map((line) => <span class="block">{line}</span>)}</h2></div><p class="max-w-md text-lg leading-8 text-muted lg:pt-8">{t.home.practiceCopy}</p></div>
      <div class="mt-14 grid border-t border-ink lg:grid-cols-3">
        {t.home.practiceItems.map((item) => <a class="group border-line relative border-b py-7 transition-colors hover:bg-primary hover:px-5 lg:border-e lg:px-5 lg:last:border-e-0" href={localePath(locale, item.href)}><span class="text-xs font-semibold text-primary group-hover:text-primary-foreground">{item.number}</span><h3 class="mt-12 max-w-48 text-xl font-semibold tracking-[-0.04em]">{item.title}</h3><p class="mt-3 max-w-64 text-sm leading-6 text-muted group-hover:text-primary-foreground/75">{item.copy}</p><span class="absolute end-5 top-7 text-xl transition-transform group-hover:translate-x-1">↗</span></a>)}
      </div>
    </section>

    <section class="border-line border-y">
      <div class="mx-auto grid w-[min(var(--site-container-width),calc(100%-2*var(--site-container-gutter)))] gap-12 py-20 sm:py-28 lg:grid-cols-[0.7fr_1.3fr]">
        <div><p class="text-xs font-semibold uppercase tracking-[0.22em] text-primary">{t.home.insightLabel}</p><h2 class="mt-5 max-w-md font-serif text-5xl leading-[0.95] tracking-[-0.06em]">{t.home.insightTitle}</h2><p class="mt-7 max-w-sm leading-7 text-muted">{t.home.insightCopy}</p></div>
        <div class="border-t border-ink">
          {posts.length > 0 ? posts.map((post) => <a class="border-line group flex items-center justify-between gap-5 border-b py-6" href={localePath(locale, `/blog/${post.id}/`)}><div><p class="text-xs text-muted">{post.data.pubDate ? new Intl.DateTimeFormat(locale, { dateStyle: 'long' }).format(new Date(post.data.pubDate)) : '—'}</p><h3 class="mt-2 text-xl font-semibold tracking-[-0.04em] group-hover:text-primary">{post.data.title}</h3></div><span class="text-xl transition-transform group-hover:translate-x-1">↗</span></a>) : <p class="py-6 text-muted">{t.insights.empty}</p>}
        </div>
      </div>
    </section>

    <section class="mx-auto flex w-[min(var(--site-container-width),calc(100%-2*var(--site-container-gutter)))] flex-col items-start justify-between gap-8 py-20 sm:py-28 md:flex-row md:items-end"><div><p class="text-xs font-semibold uppercase tracking-[0.22em] text-primary">{t.home.contactLabel}</p><h2 class="mt-5 max-w-2xl font-serif text-5xl leading-[0.95] tracking-[-0.06em] sm:text-7xl">{t.home.contactTitle}</h2><p class="mt-7 max-w-lg text-lg leading-8 text-muted">{t.home.contactCopy}</p></div><a class="inline-flex h-[var(--site-button-height)] items-center rounded-[var(--site-control-radius)] bg-primary px-5 font-semibold text-primary-foreground" href={localePath(locale, '/contact/')}>{t.home.contactCta}<span class="ms-6">↗</span></a></section>
  </main>
  <SiteFooter />
</Layout>
