---
import site from '../config/site.json';
import { defaultLocale, getMessages, localeLabel, localePath, locales } from '../lib/i18n';

const locale = Astro.currentLocale ?? defaultLocale;
const t = getMessages(locale);
const labels = t.nav ?? {};
const navigation = site.navigation ?? [];
---

<header class="border-line/80 sticky top-0 z-40 border-b bg-background/95 backdrop-blur">
  <div class="mx-auto flex min-h-18 w-[min(var(--site-container-width),calc(100%-2*var(--site-container-gutter)))] items-center justify-between gap-6">
    <a class="group inline-flex items-center gap-3 font-semibold tracking-[-0.04em]" href={localePath(locale, '/')} aria-label={site.title}>
      <span class="grid size-9 place-items-center rounded-[var(--site-control-radius)] bg-ink text-sm text-primary-foreground transition-transform group-hover:-rotate-6">A</span>
      <span>{site.title}</span>
    </a>

    <nav class="hidden items-center gap-7 text-sm text-muted md:flex" aria-label={t.common.menu}>
      {navigation.map((item) => (
        <a class="transition-colors hover:text-ink" href={localePath(locale, item.href)}>{labels[item.key] ?? item.key}</a>
      ))}
    </nav>

    <div class="flex items-center gap-3">
      <details class="relative hidden text-sm sm:block">
        <summary class="flex cursor-pointer list-none items-center gap-2 rounded-[var(--site-control-radius)] px-2 py-2 text-muted transition-colors hover:text-ink">
          <span class="font-mono text-xs uppercase">{locale}</span>
          <span aria-hidden="true">⌄</span>
        </summary>
        <div class="border-line bg-surface absolute end-0 top-full mt-2 min-w-36 rounded-[var(--site-card-radius)] border p-1 shadow-xl">
          <p class="px-3 py-2 text-xs uppercase tracking-[0.16em] text-muted">{t.common.language}</p>
          {locales.map((item) => (
            <a class="block rounded-md px-3 py-2 text-sm hover:bg-background" href={localePath(item, '/')} lang={item}>
              {localeLabel(item)}
            </a>
          ))}
        </div>
      </details>
      <a class="hidden h-[var(--site-button-height)] items-center rounded-[var(--site-control-radius)] bg-ink px-4 text-sm font-semibold text-primary-foreground transition-transform hover:-translate-y-0.5 md:inline-flex" href={localePath(locale, '/contact/')}>{labels.cta}</a>
      <details class="relative md:hidden">
        <summary class="grid size-10 cursor-pointer list-none place-items-center rounded-[var(--site-control-radius)] border border-line text-lg" aria-label={t.common.openMenu}>☰</summary>
        <div class="border-line bg-surface absolute end-0 top-full mt-2 w-56 rounded-[var(--site-card-radius)] border p-3 shadow-xl">
          <nav class="grid gap-1 text-sm" aria-label={t.common.menu}>
            {navigation.map((item) => (
              <a class="rounded-md px-3 py-2 hover:bg-background" href={localePath(locale, item.href)}>{labels[item.key] ?? item.key}</a>
            ))}
            <a class="mt-2 rounded-md bg-ink px-3 py-2 font-semibold text-primary-foreground" href={localePath(locale, '/contact/')}>{labels.cta}</a>
          </nav>
        </div>
      </details>
    </div>
  </div>
</header>
