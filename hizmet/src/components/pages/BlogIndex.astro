---
import { getCollection } from 'astro:content';
import site from '../../config/site.json';
import Layout from '../../layouts/Layout.astro';
import { defaultLocale, localePath } from '../../lib/i18n';

const locale = Astro.currentLocale ?? defaultLocale;
const posts = (await getCollection('blog')).sort((a, b) => {
	const first = a.data.pubDate ? new Date(a.data.pubDate).getTime() : 0;
	const second = b.data.pubDate ? new Date(b.data.pubDate).getTime() : 0;
	return second - first;
});
---

<Layout title={`Blog | ${site.title}`} description={site.description}>
	<header class="content-header">
		<a class="brand" href={localePath(locale, '/')}>{site.title}</a>
		<a class="back" href={localePath(locale, '/')}>← Ana sayfa</a>
	</header>
	<main class="content-shell">
		<div class="eyebrow">Blog</div>
		<h1>Notlar ve içerikler.</h1>
		<p class="lead">Git deposundaki Markdown içerikleri burada otomatik olarak yayınlanır.</p>
		<div class="post-list">
			{posts.map((post) => <a class="post" href={localePath(locale, `/blog/${post.id}/`)}>
				<div>
					<h2>{post.data.title}</h2>
					{post.data.description && <p>{post.data.description}</p>}
				</div>
				<span>↗</span>
			</a>)}
		</div>
	</main>
</Layout>

<style>
	:global(*) { box-sizing: border-box; }
	:global(body) { margin: 0; background: #eef3f1; color: #112522; font-family: Arial, sans-serif; }
	:global(a) { color: inherit; text-decoration: none; }
	.content-header { display: flex; justify-content: space-between; align-items: center; width: min(72rem, calc(100% - 2.5rem)); min-height: 5rem; margin: auto; border-bottom: 1px solid #cad8d4; }
	.brand { font-weight: 700; letter-spacing: -.04em; }
	.back { color: #64736e; font-size: .85rem; }
	.content-shell { width: min(56rem, calc(100% - 2.5rem)); margin: auto; padding: 7rem 0 8rem; }
	.eyebrow { color: #e16a3d; font-size: .7rem; font-weight: 700; letter-spacing: .16em; text-transform: uppercase; }
	h1 { margin: 1.25rem 0 0; font-size: clamp(3rem, 8vw, 6rem); line-height: .92; letter-spacing: -.08em; }
	.lead { max-width: 32rem; margin: 2rem 0 0; color: #64736e; font-size: 1.05rem; line-height: 1.7; }
	.post-list { margin-top: 4rem; border-top: 1px solid #112522; }
	.post { display: flex; align-items: center; justify-content: space-between; gap: 2rem; padding: 1.75rem 0; border-bottom: 1px solid #cad8d4; }
	.post h2 { margin: 0; font-size: 1.5rem; letter-spacing: -.04em; }
	.post p { margin: .6rem 0 0; color: #64736e; line-height: 1.5; }
	.post > span { font-size: 1.5rem; }
	.post:hover h2 { text-decoration: underline; text-underline-offset: .25rem; }
	@media (max-width: 700px) { .content-header { min-height: 4rem; } .content-shell { padding: 5rem 0; } }
</style>
