---
import Layout from '../../layouts/Layout.astro';
import site from '../../config/site.json';
import { defaultLocale, getMessages, localePath } from '../../lib/i18n';

const locale = Astro.currentLocale ?? defaultLocale;
const t = getMessages(locale);
---

<Layout title={`${t.contact.eyebrow} — ${site.title}`} description={t.contact.description}>
	<main class="page"><a class="back" href={localePath(locale, '/')}>{t.common.back}</a><div class="eyebrow">{t.contact.eyebrow}</div><h1 set:html={t.contact.title} /><p>{t.contact.copy}</p><div class="details"><a href={`tel:${site.phone}`}>{site.phone} ↗</a><a href={`mailto:${site.email}`}>{site.email} ↗</a></div></main>
</Layout>

<style>
	:global(body) { margin: 0; background: #eef3f1; color: #112522; font-family: Arial, sans-serif; }
	:global(a) { color: inherit; text-decoration: none; }
	.page { width: min(56rem, calc(100% - 2.5rem)); margin: 0 auto; padding: 5rem 0 8rem; }
	.back { display: inline-block; margin-bottom: 8rem; color: #64736e; font-size: .85rem; }
	.eyebrow { color: #e16a3d; font-size: .7rem; font-weight: 700; letter-spacing: .15em; text-transform: uppercase; }
	h1 { margin: 1.5rem 0 2rem; font-size: clamp(3.7rem, 8vw, 7rem); line-height: .9; letter-spacing: -.08em; }
	h1 :global(em) { font-family: Georgia, serif; font-weight: 400; }
	p { max-width: 28rem; color: #64736e; font-size: 1.1rem; line-height: 1.7; }
	.details { display: flex; flex-direction: column; align-items: start; gap: 1.2rem; margin-top: 3rem; }
	.details a { border-bottom: 2px solid #d5f563; padding-bottom: .4rem; font-size: 1.1rem; font-weight: 700; }
</style>
