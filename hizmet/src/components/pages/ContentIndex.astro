---
import site from '../../config/site.json';
import Layout from '../../layouts/Layout.astro';
import { defaultLocale, localePath } from '../../lib/i18n';

interface Props {
	collection: string;
	entries: Array<{ id: string; data: Record<string, unknown> }>;
}

const { collection, entries } = Astro.props;
const locale = Astro.currentLocale ?? defaultLocale;
const title = collection.replace(/[-_]+/g, ' ');
const items = entries
	.map((entry) => {
		const slug = entry.id.split('/').slice(1).join('/');
		const rawTitle = entry.data.title;
		return {
			href: localePath(locale, `/${collection}/${slug}/`),
			title: typeof rawTitle === 'string' && rawTitle.trim() ? rawTitle : slug.split('/').pop() ?? 'İçerik',
			description: typeof entry.data.description === 'string' ? entry.data.description : undefined,
		};
	})
	.sort((a, b) => a.title.localeCompare(b.title, locale));
---

<Layout title={`${title} | ${site.title}`} description={site.description}>
	<header class="content-header">
		<a class="brand" href={localePath(locale, '/')}>{site.title}</a>
		<a class="back" href={localePath(locale, '/')}>← Ana sayfa</a>
	</header>
	<main class="content-shell">
		<div class="eyebrow">{collection}</div>
		<h1>{title}</h1>
		<p class="lead">Bu collection içindeki içerikler Git deposundan otomatik olarak okunur.</p>
		<div class="entry-list">
			{items.map((item) => <a class="entry" href={item.href}>
				<div><h2>{item.title}</h2>{item.description && <p>{item.description}</p>}</div>
				<span>↗</span>
			</a>)}
		</div>
	</main>
</Layout>

<style>
	:global(*) { box-sizing: border-box; }
	:global(body) { margin: 0; background: #eef3f1; color: #112522; font-family: Arial, sans-serif; }
	:global(a) { color: inherit; text-decoration: none; }
	.content-header { display: flex; justify-content: space-between; align-items: center; width: min(72rem, calc(100% - 2.5rem)); min-height: 5rem; margin: auto; border-bottom: 1px solid #cad8d4; }
	.brand { font-weight: 700; letter-spacing: -.04em; }
	.back { color: #64736e; font-size: .85rem; }
	.content-shell { width: min(56rem, calc(100% - 2.5rem)); margin: auto; padding: 7rem 0 8rem; }
	.eyebrow { color: #e16a3d; font-size: .7rem; font-weight: 700; letter-spacing: .16em; text-transform: uppercase; }
	h1 { margin: 1.25rem 0 0; font-size: clamp(3rem, 8vw, 6rem); line-height: .92; letter-spacing: -.08em; text-transform: capitalize; }
	.lead { max-width: 32rem; margin: 2rem 0 0; color: #64736e; font-size: 1.05rem; line-height: 1.7; }
	.entry-list { margin-top: 4rem; border-top: 1px solid #112522; }
	.entry { display: flex; align-items: center; justify-content: space-between; gap: 2rem; padding: 1.75rem 0; border-bottom: 1px solid #cad8d4; }
	.entry h2 { margin: 0; font-size: 1.5rem; letter-spacing: -.04em; }
	.entry p { margin: .6rem 0 0; color: #64736e; line-height: 1.5; }
	.entry > span { font-size: 1.5rem; }
	.entry:hover h2 { text-decoration: underline; text-underline-offset: .25rem; }
	@media (max-width: 700px) { .content-header { min-height: 4rem; } .content-shell { padding: 5rem 0; } }
</style>
