---
import Layout from '../../layouts/Layout.astro';
import site from '../../config/site.json';
import { defaultLocale, getMessages, localePath } from '../../lib/i18n';

const locale = Astro.currentLocale ?? defaultLocale;
const t = getMessages(locale);
---

<Layout title={site.title} description={site.description}>
	<header class="site-header wrapper"><a class="brand" href={localePath(locale, '/')}><span class="mark">H</span><span>{site.title}</span></a><nav><a href={`#${t.home.servicesAnchor}`}>{t.nav.services}</a><a href={`#${t.home.processAnchor}`}>{t.nav.process}</a><a href={localePath(locale, '/iletisim/')}>{t.nav.contact}</a></nav><a class="phone" href={`tel:${site.phone}`}> {site.phone} <span>↗</span></a></header>
	<main>
		<section class="hero wrapper"><div class="hero-copy"><div class="eyebrow">{t.home.heroEyebrow}</div><h1 set:html={t.home.heroTitle} /><p>{t.home.heroCopy}</p><a class="button" href={localePath(locale, '/iletisim/')}>{t.home.heroCta} <span>↗</span></a></div><div class="hero-panel"><span class="panel-label">{t.home.panelLabel}</span><div class="panel-shape"><span>H</span></div><p set:html={t.home.panelTitle} /></div></section>
		<section id={t.home.servicesAnchor} class="services band"><div class="wrapper"><div class="section-intro"><div class="eyebrow">{t.home.servicesEyebrow}</div><h2 set:html={t.home.servicesTitle} /><p>{t.home.servicesCopy}</p></div><div class="service-list">{t.home.serviceItems.map((item, index) => <article><span>{String(index + 1).padStart(2, '0')}</span><div><h3>{item.title}</h3><p>{item.copy}</p></div><b>↗</b></article>)}</div></div></section>
		<section id={t.home.processAnchor} class="process wrapper"><div class="eyebrow">{t.home.processEyebrow}</div><h2 set:html={t.home.processTitle} /><div class="process-grid">{t.home.processSteps.map((step, index) => <div><span>{String(index + 1).padStart(2, '0')}</span><h3>{step.title}</h3><p>{step.copy}</p></div>)}</div></section>
		<section class="cta wrapper"><div><div class="eyebrow">{t.home.ctaEyebrow}</div><h2 set:html={t.home.ctaTitle} /></div><a class="button button-green" href={localePath(locale, '/iletisim/')}>{t.home.ctaButton} <span>↗</span></a></section>
	</main>
	<footer class="footer wrapper"><a class="brand" href={localePath(locale, '/')}><span class="mark">H</span><span>{site.title}</span></a><span>{site.footer}</span><a href={`mailto:${site.email}`}>{site.email}</a></footer>
</Layout>

<style>
	:global(*){box-sizing:border-box}:global(body){margin:0;background:#eef3f1;color:#112522;font-family:Arial,sans-serif}:global(a){color:inherit;text-decoration:none}.wrapper{width:min(72rem,calc(100% - 2.5rem));margin-inline:auto}.site-header{display:flex;align-items:center;gap:2rem;min-height:5rem;border-bottom:1px solid #cad8d4}.brand{display:inline-flex;align-items:center;gap:.6rem;font-weight:700;letter-spacing:-.04em}.mark{display:grid;place-items:center;width:1.7rem;height:1.7rem;background:#174c43;color:#d5f563;font-size:.85rem}.site-header nav{display:flex;gap:1.5rem;margin-left:auto;color:#64736e;font-size:.85rem}.phone{padding:.75rem 1rem;border:1px solid #174c43;font-size:.8rem;font-weight:700}.phone span,.button span{margin-left:1rem}.hero{display:grid;grid-template-columns:1fr 1fr;gap:4rem;padding:8rem 0}.eyebrow{color:#e16a3d;font-size:.7rem;font-weight:700;letter-spacing:.15em;text-transform:uppercase}.hero h1,h2{margin:1.5rem 0 0;letter-spacing:-.08em}.hero h1{font-size:clamp(3.7rem,7vw,6.8rem);line-height:.9}.hero h1 :global(em),h2 :global(em){font-family:Georgia,serif;font-weight:400}.hero-copy>p{max-width:28rem;margin-top:2.5rem;color:#64736e;line-height:1.7}.button{display:inline-flex;align-items:center;margin-top:2rem;padding:1rem 1.25rem;background:#174c43;color:#fff;font-size:.85rem;font-weight:700}.hero-panel{position:relative;min-height:29rem;overflow:hidden;padding:1.25rem;background:#d5f563}.panel-label{position:relative;z-index:1;font-size:.75rem;font-weight:700}.panel-shape{display:grid;place-items:center;width:18rem;height:18rem;margin:3rem auto 0;border-radius:50% 50% 0 0;background:#174c43;color:#d5f563;font-size:9rem;font-weight:700;letter-spacing:-.15em}.hero-panel p{margin:2rem 0 0;font-size:1.35rem;line-height:1.1;font-weight:700;letter-spacing:-.05em}.band{border-block:1px solid #cad8d4;background:#e2ebe7}.services{padding:7rem 0}.services .wrapper{display:grid;grid-template-columns:1fr 1.5fr;gap:5rem}.section-intro h2,.process h2,.cta h2{font-size:clamp(2.8rem,5vw,4.8rem);line-height:.95}.section-intro p{max-width:18rem;margin-top:2rem;color:#64736e;line-height:1.6}.service-list{border-top:1px solid #174c43}.service-list article{display:grid;grid-template-columns:2rem 1fr 2rem;gap:1.25rem;padding:1.5rem 0;border-bottom:1px solid #cad8d4}.service-list article>span{color:#e16a3d;font-size:.75rem;font-weight:700}.service-list h3,.process h3{margin:0;font-size:1.25rem;letter-spacing:-.04em}.service-list p,.process p{margin:.5rem 0 0;color:#64736e;font-size:.9rem;line-height:1.5}.service-list b{text-align:right}.process{padding:7rem 0}.process h2{margin-bottom:4rem}.process-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:1rem}.process-grid>div{padding-top:1rem;border-top:1px solid #174c43}.process-grid span{color:#e16a3d;font-size:.75rem;font-weight:700}.process-grid h3{margin-top:3rem}.cta{display:flex;align-items:end;justify-content:space-between;padding:4rem 0 7rem;border-top:1px solid #cad8d4}.button-green{background:#d5f563;color:#112522}.footer{display:flex;justify-content:space-between;align-items:center;gap:2rem;min-height:5rem;border-top:1px solid #cad8d4;color:#64736e;font-size:.75rem}@media(max-width:700px){.site-header nav,.phone{display:none}.hero,.services .wrapper,.process-grid{grid-template-columns:1fr}.hero{padding:6rem 0 5rem}.hero-panel{min-height:20rem}.panel-shape{width:12rem;height:12rem;margin-top:2rem;font-size:6rem}.services{padding:5rem 0}.services .wrapper{gap:3rem}.process,.cta{padding:5rem 0}.cta,.footer{align-items:start;flex-direction:column}.footer{gap:.75rem;padding:2rem 0}}
</style>
